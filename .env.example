NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://gatehouse:gatehouse@localhost:5546/gatehouse

# The `iss` claim of every token, and the public base URL of this service.
ISSUER=http://localhost:4000
# The `aud` claim. Resource servers should require it.
AUDIENCE=gatehouse

# 32 random bytes, base64. Encrypts signing keys and TOTP secrets at rest.
# Generate with: pnpm cli generate-key
KEY_ENCRYPTION_KEY=

# Optional modules, comma-separated: rbac, abac, oauth, mfa, audit.
# Leave empty for JWT authentication only.
MODULES=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Requests per minute per IP: everywhere, and on sign-in style endpoints.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Failed sign-ins before an account locks, and the first lock's length.
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900

# Browser origins allowed to call the API, comma-separated. Empty disables CORS.
CORS_ORIGINS=

# Only with the oauth module. A JSON array, one object per provider:
# [{"id":"google","clientId":"...","clientSecret":"...",
#   "authorizationUrl":"https://accounts.google.com/o/oauth2/v2/auth",
#   "tokenUrl":"https://oauth2.googleapis.com/token",
#   "userInfoUrl":"https://openidconnect.googleapis.com/v1/userinfo"}]
OAUTH_PROVIDERS=[]
# Where a browser may be sent after an OAuth sign-in. Exact matches, comma-separated.
OAUTH_REDIRECT_ALLOWLIST=
